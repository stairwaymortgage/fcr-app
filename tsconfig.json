{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    /*
     * Legal only because "noEmit" above is true — tsc never has to rewrite the
     * specifier, so a ".ts" import is a compile-time-only detail.
     *
     * Needed by exactly two imports: lib/search.ts and lib/browse.ts pull in
     * lib/test-rows.ts by relative path WITH the extension. Both modules are
     * loaded at runtime by scripts/verify-test-row-isolation.mjs under
     * `node --experimental-strip-types`, and node's ESM resolver requires a real
     * file specifier — it honours neither the "@/*" alias below nor extensionless
     * resolution. See the note at the top of lib/search.ts.
     */
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  /*
   * `_handoff` holds design/reference material, not application source. It is
   * gitignored, but "include" above sweeps **\/*.ts, so tsc would still
   * type-check it — and _handoff/09_dbpr_ingestion/sync_dbpr.ts imports
   * packages we do not install until Week 2 (@supabase/supabase-js,
   * csv-parse). That breaks `next build`, which is what Vercel runs.
   *
   * When sync_dbpr.ts is needed, copy it into lib/ alongside its
   * dependencies — that is where it should be type-checked.
   */
  "exclude": ["node_modules", "_handoff"]
}
